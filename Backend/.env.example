PORT=3000

# PostgreSQL running from docker-compose.yml. For Supabase, use its transaction
# pooler URL for DATABASE_URL and its direct connection URL for DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/novel_platform?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/novel_platform?schema=public"
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES=7d

# Set this to the API key configured for the SePay webhook (without the "Apikey " prefix).
SEPAY_WEBHOOK_API_KEY=

# Required only by upload-related services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Novel metadata assistant and moderation (configure DeepSeek API key on the server only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ASSISTANT=deepseek-flash
DEEPSEEK_MODEL_MODERATION=deepseek-flash
# Set true temporarily to send only the latest user message, without Novel tools or chat history.
AI_ASSISTANT_ISOLATED_MODE=false
# Optional prices used only for estimated usage reporting, USD per million tokens
# AI_INPUT_COST_PER_MILLION_USD=...
# AI_OUTPUT_COST_PER_MILLION_USD=...
